hi := function () {
        print("Hi")
        2
}

print(2 + 2 * 8, "HI", "\n")
print(hi(), "\n", [4 5 6], "\n")

x := function (n)
{
        i := 1
        while (i < n + 1)
        {
                print(i, "\n")
                i = i + 1
        }
        
        i
}

print("last: " x(10), "\n")
